{
  "name": "respkit",
  "version": "1.0.0",
  "description": "Normalize API responses and errors from Fetch and Axios into a consistent, predictable TypeScript structure.",
  "author": "Saad Raja",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "api",
    "response",
    "normalize",
    "fetch",
    "axios",
    "typescript",
    "error-handling",
    "rest-api",
    "http",
    "validation"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "axios": "^1.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "rimraf": "^5.0.0"
  },
  "peerDependencies": {
    "axios": ">=0.21.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saadraj4/respkit.git"
  },
  "sideEffects": false
}